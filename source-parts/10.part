covery:p[0]==='Recovery'}});
function seed(){const result={};weeks.forEach(w=>{const values=[w.recovery?'Off / recovery':'Off or Z1 30–45m',w.tue,w.recovery?'Z2 60–90m':'Z2 90–120m',w.thu,'Easy 60–75m / coffee',w.sat,w.recovery?'1.5–2h Z2':'2.5–3h Z2 (flex)'];const types=['rest','key','easy',w.recovery?'easy':'hard','rest',w.recovery?'easy':'hard','easy'];values.forEach((name,i)=>{const date=plus(w.start,i);result[date]={name,type:types[i],detail:i===1?'Protected key workout · adapt based on fatigue':i===3?'Conditional: hard group ride replaces a second interval session':i===5?'Enjoy the group. Count this as hard if race-like intensity.':'',done:false}})});return result}
const STORAGE='velo-training-v1';let saved;try{saved=JSON.parse(localStorage.getItem(STORAGE)||'{}')}catch{saved={}};
let workouts=saved.workouts||seed();let ftp=Number(saved.ftp)||400;let month=new Date(2026,10,1);let tab='calendar';
function persist(){localStorage.setItem(STORAGE,JSON.stringify({workouts,ftp}))}
const clean=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const currentWeek=date=>weeks.find(w=>date>=w.start&&date<=plus(w.start,6));
const monthName=d=>d.toLocaleDateString('en-US',{month:'long',year:'numeric'});
