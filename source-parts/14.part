><button class="close" id="close" aria-label="Close">×</button></div><h2>'+(isNew?'Add a workout':'Edit workout')+'</h2><div class="field"><label>Workout / ride</label><input id="workoutname" value="'+clean(x.name)+'" placeholder="e.g., 5×5 VO2, team group ride"/></div><div class="field"><label>Ride category</label><select id="workouttype">'+[['key','Key intervals'],['hard','Group / hard'],['easy','Endurance / easy'],['rest','Recovery / off']].map(y=>'<option value="'+y[0]+'"'+(x.type===y[0]?' selected':'')+'>'+y[1]+'</option>').join('')+'</select></div><div class="field"><label>Notes</label><textarea id="workoutdetail" placeholder="Intervals, route, group ride alternatives, race notes...">'+clean(x.detail||'')+'</textarea></div><div class="field"><label><input type="checkbox" id="workoutdone" '+(x.done?'checked':'')+' style="display:inline;width:auto;margin-right:9px">Completed</label></div><div id="powerhint" class="callout"></div><div class="actions"><button class="button primary" id="saveworkout">Save workout</button><button class="button" id="deleteworkout">Clear day</button></div></div></div>';
document.getElementById('close').onclick=closeModal;document.querySelector('.modal-backdrop').onclick=e=>{if(e.target.classList.contains('modal-backdrop'))closeModal()};
document.getElementById('saveworkout').onclick=()=>{const name=document.getElementById('workoutname').value.trim