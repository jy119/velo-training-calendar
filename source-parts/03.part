ound:#f1f1ed;border-color:#b4bbb3}.event.done{opacity:.56;text-decoration:line-through}.event:hover{filter:brightness(.97)}
.weekbar{border-radius:13px;background:var(--ink);color:white;display:flex;justify-content:space-between;align-items:center;padding:17px 21px;margin-bottom:18px;gap:14px;flex-wrap:wrap}.weekbar b{font-size:17px}.weekbar span{font-size:12px;color:#c2d3cc}.weekbar button{background:#3b5550;color:white;border:1px solid #58726c;padding:7px 12px;border-radius:8px}.weeks{display:grid;gap:11px}.week-row{background:white;border:1px solid var(--line);border-radius:13px;display:grid;grid-template-columns:120px 150px 1fr 100px 115px;align-items:center;gap:16px;padding:17px 20px;cursor:pointer}.week-row:hover{border-color:var(--teal)}.week-row b{font-size:13px}.week-row .phase{font-size:11px;color:var(--teal);font-weight:800}.week-row p{font-size:12px;margin:0;color:var(--muted)}.weeks .week-row .range{font-size:12px;color:var(--muted)}
.block-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.block{background:white;border:1px solid var(--line);padding:23px;border-radius:15px}.block h3{font:800 20px Manrope;margin:8px 0}.block p{font-size:13px;line-height:1.55;color:var(--muted)}.block .count{font-size:11px;text-transform:uppercase;color:var(--accent);font-weight:800;letter-spacing:1px}
.panel{background:white;border:1px solid var(--line);border