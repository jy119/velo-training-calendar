)+'</span><h3>'+clean(p.name)+'</h3><p>'+clean(p.focus)+'. '+(p.name==='Recovery'?'Absorb training; trim volume and intensity.':p.name.includes('Race')?'Prioritize events and arrive fresh.':'Adapt Thursday and Saturday around the group.')+'</p></div>').join('')}
function renderSettings(){document.getElementById('ftp').value=ftp;const data=[['Z2 endurance',.60,.75],['Tempo',.80,.85],['Sweet spot',.88,.92],['Threshold',.95,1],['VO2 max',1.10,1.20]];document.getElementById('zones').innerHTML='<tr><th>Zone</th><th>Power</th></tr>'+data.map(x=>'<tr><td>'+x[0]+'</td><td>'+Math.round(ftp*x[1])+'–'+Math.round(ftp*x[2])+' W</td></tr>').join('')}
function render(){renderStats();renderCalendar();renderWeeks();renderBlocks();renderSettings()}
function switchTab(t){tab=t;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x.dataset.tab===t));['calendar','weeks','blocks','settings'].forEach(s=>document.getElementById(s+'-view').classList.toggle('hide',s!==t));render()}
function closeModal(){document.getElementById('modalroot').innerHTML=''}
function openModal(id){const x=workouts[id]||{name:'',type:'easy',detail:'',done:false};const isNew=!workouts[id];document.getElementById('modalroot').innerHTML='<div class="modal-backdrop"><div class="modal"><div class="modal-head"><span class="eyebrow">'+pretty(id)+' · '+parse(id).toLocaleDateString('en-US',{weekday:'long'})+'</span