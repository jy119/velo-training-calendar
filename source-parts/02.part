;width:37px;height:37px;font-size:21px}.select{padding:10px;border-radius:9px;border:1px solid var(--line);background:white;color:var(--ink)}.legend{display:flex;gap:18px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin-bottom:15px}.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px}
.calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7px}.weekday{color:var(--muted);font-weight:800;text-transform:uppercase;font-size:11px;text-align:center;padding:9px}.day{background:white;border:1px solid var(--line);border-radius:12px;min-height:147px;padding:11px;transition:.15s;min-width:0}.day.out{background:transparent;border-color:transparent;opacity:.45}.day.today{border:2px solid var(--teal)}.day:hover{border-color:#9ab7ad}.day .date{font-size:12px;color:var(--muted);font-weight:800;display:flex;justify-content:space-between;align-items:center}.event{display:block;text-align:left;width:100%;border:0;border-left:3px solid var(--teal);border-radius:5px;background:#edf2ef;padding:7px 8px;margin-top:12px;color:var(--ink);font-size:12px;font-weight:800;line-height:1.28}.event small{display:block;font-size:10px;font-weight:500;margin-top:4px;color:#65716a}.event.key{background:#fceee9;border-color:var(--accent)}.event.hard{background:#f8e8d5;border-color:#c48a4f}.event.easy{background:#edf1f7;border-color:var(--blue)}.event.rest{backgr