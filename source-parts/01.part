n.primary{background:var(--ink);color:white;border-color:var(--ink)}.button.ghost{background:transparent}.button:hover{border-color:var(--teal)}.intro{padding:44px 0 24px;display:flex;align-items:flex-end;justify-content:space-between;gap:20px}.eyebrow{text-transform:uppercase;letter-spacing:2px;color:var(--accent);font-size:11px;font-weight:800}.intro h1{font-family:Manrope,sans-serif;letter-spacing:-2.4px;font-weight:800;font-size:clamp(32px,4vw,52px);line-height:1.13;margin:12px 0}.sub{color:var(--muted);margin:0;font-size:14px}.stats{display:flex;gap:10px}.stat{min-width:120px;background:white;border:1px solid var(--line);border-radius:13px;padding:14px 18px}.stat b{font:800 27px Manrope;display:block;letter-spacing:-1px}.stat small{font-size:11px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.7px}
.tabs{display:flex;gap:24px;border-bottom:1px solid var(--line);margin-top:24px}.tab{background:none;border:0;border-bottom:3px solid transparent;padding:15px 0;font-weight:800;font-size:13px;color:var(--muted)}.tab.active{color:var(--ink);border-color:var(--accent)}
.toolbar{display:flex;justify-content:space-between;align-items:center;padding:23px 0 15px;flex-wrap:wrap;gap:12px}.month-label{font:800 24px Manrope;letter-spacing:-.8px}.controls{display:flex;gap:7px;align-items:center}.nav{border:1px solid var(--line);border-radius:8px;background:white