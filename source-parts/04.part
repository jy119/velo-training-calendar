-radius:14px;padding:24px}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.field{display:block;margin:13px 0}.field label{display:block;font-weight:800;font-size:12px;margin-bottom:7px}.field input,.field select,.field textarea{display:block;width:100%;padding:11px 12px;background:white;border:1px solid #d8ded8;border-radius:8px;color:var(--ink)}.field textarea{min-height:90px;resize:vertical}.zone-table{width:100%;border-collapse:collapse}.zone-table td,.zone-table th{padding:11px 8px;border-bottom:1px solid var(--line);text-align:left;font-size:13px}.zone-table th{font-size:11px;color:var(--muted)}
.modal-backdrop{position:fixed;inset:0;background:#152d2ccc;z-index:9;display:flex;justify-content:center;align-items:center;padding:16px}.modal{background:var(--bg);width:min(530px,100%);border-radius:18px;padding:25px;max-height:92vh;overflow:auto;box-shadow:0 20px 90px #0004}.modal-head{display:flex;align-items:center;justify-content:space-between}.modal h2{font:800 25px Manrope;letter-spacing:-.8px;margin:8px 0}.close{font-size:26px;border:none;background:none;color:var(--muted)}.actions{display:flex;gap:9px;margin-top:22px;flex-wrap:wrap}.actions .button{flex:1}.smallnote{font-size:12px;color:var(--muted);line-height:1.55}.callout{padding:12px 15px;background:var(--pale);border-radius:9px;color:var(--teal);font-size:12px}.hide{display:none!important}
